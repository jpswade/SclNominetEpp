{
    "name": "sclinternet/scl-nominet-epp",
    "description": "PHP library for communicating with Nominet's EPP interface",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/SCLInternet/SclNominetEpp",
    "authors": [
        {
            "name": "Tom Oram",
            "email": "tom@x2k.co.uk",
            "homepage": "https://github.com/tomphp"
        },
        {
            "name": "Merlyn Cooper",
            "email": "merlyn.cooper@hotmail.co.uk",
            "homepage": "https://github.com/Merlyn-Cooper"
        },
        {
            "name": "James Wade",
            "email": "jpswade@gmail.com",
            "homepage": "https://github.com/jpswade"
        }
    ],
    "require": {
        "php": ">=7.4",
        "sclinternet/scl-contact": "dev-master",
        "sclinternet/scl-socket": "dev-master",
        "sclinternet/scl-request-response": "dev-master",
        "ext-simplexml": "*",
        "ext-xmlwriter": "*",
        "ext-dom": "*"
    },
    "autoload": {
        "psr-4": {
            "SclNominetEpp\\": "src/SclNominetEpp/"
        }
    },
    "require-dev": {
        "phpunit/phpunit" : "^9.6",
        "squizlabs/php_codesniffer" : "^3.10",
        "phpmd/phpmd" : "^2.15",
        "phpstan/phpstan": "^1.10",
        "symfony/config": "^5.4",
        "symfony/dependency-injection": "^5.4",
        "symfony/filesystem": "^5.4"
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "cs": "phpcs --standard=phpcs.xml",
        "cs-fix": "phpcbf --standard=phpcs.xml",
        "cs-check": "phpcs --standard=phpcs.xml --report=summary",
        "phpmd": "phpmd src text phpmd.xml",
        "phpstan": "phpstan analyse -c phpstan.neon.dist --memory-limit=512M",
        "phpstan-baseline": "phpstan analyse -c phpstan.neon.dist --memory-limit=512M --generate-baseline phpstan-baseline.neon",
        "quality": [
            "@cs-check",
            "@phpmd",
            "@phpstan",
            "@test"
        ],
        "quality-fix": [
            "@cs-fix",
            "@test"
        ]
    }
}
